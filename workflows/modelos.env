# Modelos de los workflows iniciales, por proveedor y por papel. Los lee scripts/seed-workflows.sh,
# que sustituye cada ${VARIABLE} de workflows/*.yaml antes de publicarlos.
#
# Vacío: la línea `model:` desaparece y el CLI usa su modelo por defecto (el de ~/.codex/config.toml
# en Codex, el de la cuenta en Antigravity; en ninguno de los dos hay estimación de coste).
# Una variable del entorno con el mismo nombre manda sobre este fichero.
# Por qué cada uno: docs/arranque-local.md, «Qué proveedor para qué».

# Claude Code: alias que el CLI resuelve al último modelo de cada familia.
CLAUDE_FUERTE=opus      # planificar, revisar arquitectura y sintetizar
CLAUDE_GENERAL=sonnet   # implementar y corregir
CLAUDE_RAPIDO=haiku     # tareas acotadas y baratas

# Codex: comprueba los nombres con `codex` (/model) antes de rellenarlos.
CODEX_FUERTE=           # su modelo principal (GPT-6.1 Sol según la documentación de octubre de 2026)
CODEX_RAPIDO=           # su modelo rápido y barato (la familia Luna)

# Antigravity CLI: los ids exactos los da `agy models` (sin espacios, p. ej. gemini-3.1-pro-high).
AGY_FUERTE=             # Gemini 4 Argon si tu plan lo tiene (cuota semanal aparte)
AGY_RAPIDO=             # un Gemini Flash
