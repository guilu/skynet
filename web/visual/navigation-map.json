    {
      "id": "project-empty",
      "order": 10,
      "title": "Proyecto vacío",
      "group": "work",
      "route": "/projects/:id (sin trabajos)",
      "capture": "viewport",
      "notes": "Estado vacío: un proyecto recién creado.",
      "links": [{ "to": "new-work-item", "type": "dialog", "label": "Nuevo trabajo" }]
    },
    {
      "id": "new-work-item",
      "order": 11,
      "title": "Diálogo: nuevo trabajo",
      "group": "work",
      "route": "/projects/:id → Nuevo trabajo",
      "capture": "viewport",
      "links": [{ "to": "work-item", "type": "action", "label": "Crear" }]
    },
    {
      "id": "work-item",
      "order": 12,
      "title": "Trabajo",
      "group": "work",
      "route": "/work-items/:id",
      "capture": "fullPage",
      "links": [
        { "to": "launch-workflow", "type": "dialog", "label": "Lanzar workflow" },
        { "to": "run-completed", "type": "navigation" },
        { "to": "project-work", "type": "return" }
      ]
    },
    {
      "id": "workflows",
      "order": 13,
      "title": "Workflows",
      "group": "automation",
      "route": "/workflows",
      "capture": "fullPage",
      "links": [
        { "to": "workflow-summary", "type": "navigation" },
        { "to": "workflow-new", "type": "action", "label": "Nuevo workflow" }
      ]
    },
    {
      "id": "workflow-summary",
      "order": 14,
      "title": "Workflow: resumen",
      "group": "automation",
      "route": "/workflows/:key?view=graph",
      "capture": "viewport",
      "notes": "Versión publicada, con su grafo.",
      "links": [
        { "to": "workflow-yaml", "type": "tab" },
        { "to": "workflow-editor", "type": "action", "label": "Editar" }
      ]
    },
    {
      "id": "workflow-yaml",
      "order": 15,
      "title": "Workflow: YAML",
      "group": "automation",
      "route": "/workflows/:key",
      "capture": "viewport",
      "links": [{ "to": "workflow-summary", "type": "tab" }]
    },
    {
      "id": "workflow-editor",
      "order": 16,
      "title": "Workflow: editor visual",
      "group": "automation",
      "route": "/workflows/:key?version=:borrador&view=graph",
      "capture": "viewport",
      "notes": "Borrador v2 abierto en el grafo editable. En el móvil el grafo no se edita (solo se ve).",
      "links": [{ "to": "workflow-summary", "type": "return" }]
    },
    {
      "id": "workflow-new",
      "order": 17,
      "title": "Nuevo workflow",
      "group": "automation",
      "route": "/workflows/new",
      "capture": "fullPage",
      "links": [{ "to": "workflow-editor", "type": "action", "label": "Crear" }]
    },
    {
      "id": "launch-workflow",
      "order": 18,
      "title": "Diálogo: lanzar workflow",
      "group": "automation",
      "route": "/work-items/:id → Lanzar workflow",
      "capture": "viewport",
      "links": [{ "to": "run-active", "type": "action", "label": "Lanzar" }]
    },
    {
