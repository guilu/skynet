{
  "$comment": "Inventario único de la galería visual (VS-A) y del mapa de navegación (VS-B). Cada pantalla se captura como NN-id.png; cada id tiene su preparador en screens.ts.",
  "canonical": { "viewport": "desktop", "theme": "light" },
  "viewports": {
    "desktop": { "width": 1440, "height": 1000 },
    "mobile": { "width": 390, "height": 844 }
  },
  "themes": ["light", "dark"],
  "linkTypes": {
    "navigation": "Navegación normal",
    "tab": "Cambio de pestaña",
    "dialog": "Abre un diálogo",
    "menu": "Abre un menú",
    "action": "Acción que crea o lanza algo",
    "return": "Retorno o cierre"
  },
  "groups": [
    { "id": "access", "title": "Acceso" },
    { "id": "overview", "title": "Inicio y supervisión" },
    { "id": "work", "title": "Trabajo" },
    { "id": "automation", "title": "Automatización" },
    { "id": "execution", "title": "Ejecución" },
    { "id": "decisions", "title": "Decisiones" },
    { "id": "settings", "title": "Configuración" },
    { "id": "overlays", "title": "Overlays y estados transversales" }
  ],
  "screens": [
    {
      "id": "login",
      "order": 1,
      "title": "Login",
      "group": "access",
      "route": "/ (sin sesión)",
      "capture": "viewport",
      "entry": true,
      "links": [{ "to": "dashboard", "type": "action", "label": "Entrar" }]
    },
    {
      "id": "dashboard",
      "order": 2,
      "title": "Dashboard",
      "group": "overview",
      "route": "/",
      "capture": "fullPage",
      "notes": "Con actividad y con una aprobación en «Necesita tu atención»: una sola captura cubre los dos estados.",
      "links": [
        { "to": "projects", "type": "navigation" },
        { "to": "workflows", "type": "navigation" },
        { "to": "runs", "type": "navigation" },
        { "to": "approvals", "type": "navigation" },
        { "to": "runners", "type": "navigation" },
        { "to": "usage", "type": "navigation" },
        { "to": "activity", "type": "navigation" },
        { "to": "settings-colors", "type": "navigation" },
        { "to": "approval-pending", "type": "navigation", "label": "Necesita tu atención" },
        { "to": "run-active", "type": "navigation", "label": "Ejecuciones recientes" },
        { "to": "command-palette", "type": "dialog", "label": "⌘K" },
        { "to": "theme-menu", "type": "menu" },
        { "to": "companion-menu", "type": "menu" }
      ]
    },
    {
      "id": "usage",
      "order": 3,
      "title": "Uso",
      "group": "overview",
      "route": "/usage",
      "capture": "fullPage",
      "links": [{ "to": "dashboard", "type": "return" }]
    },
    {
      "id": "activity",
      "order": 4,
      "title": "Actividad",
      "group": "overview",
      "route": "/activity",
      "capture": "fullPage",
      "links": [{ "to": "run-completed", "type": "navigation" }]
    },
    {
      "id": "runners",
      "order": 5,
      "title": "Runners",
      "group": "overview",
      "route": "/runners",
      "capture": "fullPage",
      "links": []
    },
    {
      "id": "projects",
      "order": 6,
      "title": "Proyectos",
      "group": "work",
      "route": "/projects",
      "capture": "fullPage",
      "links": [
        { "to": "project-work", "type": "navigation", "label": "DEMO" },
        { "to": "project-empty", "type": "navigation", "label": "PROTO" }
      ]
    },
    {
      "id": "project-work",
      "order": 7,
      "title": "Proyecto: trabajos",
      "group": "work",
      "route": "/projects/:id",
      "capture": "fullPage",
      "notes": "El proyecto no tiene pestaña «Resumen»: su cabecera y la pestaña Trabajos (la de entrada) hacen de resumen.",
      "links": [
        { "to": "project-repos", "type": "tab" },
        { "to": "project-memory", "type": "tab" },
        { "to": "work-item", "type": "navigation" },
        { "to": "new-work-item", "type": "dialog", "label": "Nuevo trabajo" }
      ]
    },
    {
      "id": "project-repos",
      "order": 8,
      "title": "Proyecto: repositorios",
      "group": "work",
      "route": "/projects/:id?tab=repos",
      "capture": "fullPage",
      "links": [{ "to": "project-work", "type": "tab" }]
    },
    {
      "id": "project-memory",
      "order": 9,
      "title": "Proyecto: memoria",
      "group": "work",
      "route": "/projects/:id?tab=memory",
      "capture": "fullPage",
      "links": [{ "to": "run-memory", "type": "navigation", "label": "Ver la ejecución" }]
