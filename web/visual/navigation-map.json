      "route": "/runs/:id",
      "capture": "viewport",
      "notes": "Ejecución completada de «Revisión con Codex y Antigravity». La conversación es la vista por defecto del panel central, así que esta captura también es «Ejecución: conversación».",
      "links": [
        { "to": "run-waterfall", "type": "tab" },
        { "to": "run-events", "type": "tab" },
        { "to": "run-prompt", "type": "tab" },
        { "to": "run-tools", "type": "tab" },
        { "to": "run-verification", "type": "tab" },
        { "to": "run-cost", "type": "tab" },
        { "to": "runs", "type": "return" }
