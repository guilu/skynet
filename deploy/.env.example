# Copia este fichero a deploy/.env (no se sube al repositorio) y rellena lo marcado como obligatorio.
# docker compose lo lee solo: docker compose -f deploy/docker-compose.yml --profile app up -d --build --wait

# --- Obligatorio con el perfil app ---
# Contraseña del usuario de la web (y de la API por HTTP Basic). Sin ella la API no arranca.
SKYNET_ADMIN_PASSWORD=
# Secreto compartido con los runners para registrarse. Vacío: no se puede registrar ningún runner.
SKYNET_RUNNER_REGISTRATION_TOKEN=
# Contraseña de PostgreSQL. Sin ella la API no arranca. Se fija en el primer arranque y queda
# guardada en el volumen: si ya lo creaste con «skynet», pon ese valor o cámbiala con ALTER USER.
SKYNET_DB_PASSWORD=

# --- Opcional ---
#SKYNET_ADMIN_USER=admin
# Usuario de la base de datos (antes del primer arranque: queda guardado en el volumen).
#SKYNET_DB_USER=skynet
# Puertos publicados. PostgreSQL solo escucha en este equipo (SKYNET_DB_BIND=0.0.0.0 para abrirlo).
#SKYNET_WEB_PORT=8081
#SKYNET_API_PORT=8080
#SKYNET_DB_PORT=5432
#SKYNET_DB_BIND=127.0.0.1
# Detrás de HTTPS, para que la cookie de sesión solo viaje cifrada.
#SKYNET_SECURE_COOKIES=false
#SKYNET_SESSION_TIMEOUT=12h
# Otros orígenes que pueden llamar a la API desde el navegador, separados por comas.
#SKYNET_CORS_ORIGINS=
#SKYNET_WORKTREE_RETENTION=7d
#SKYNET_VERIFICATION_TIMEOUT=30m
# Tras cancelar, cuánto se espera a que el runner confirme antes de darlo por cancelado.
#SKYNET_CANCEL_TIMEOUT=70s
# GitHub App (docs/github.md): id, ruta en este equipo al .pem que da GitHub y secreto de los
# webhooks. Sin las tres, Skynet no habla con GitHub. La API y la web cambian solo con GitHub
# Enterprise.
#SKYNET_GITHUB_APP_ID=
#SKYNET_GITHUB_PRIVATE_KEY_FILE=
#SKYNET_GITHUB_WEBHOOK_SECRET=
#SKYNET_GITHUB_API_URL=https://api.github.com
#SKYNET_GITHUB_WEB_URL=
# La URL con la que abres Skynet, para que las PR que abre enlacen su ejecución. Vacía: sin enlace.
#SKYNET_PUBLIC_URL=
# Puerto que solo sirve los webhooks de GitHub; es el único que se abre a internet con el túnel.
#SKYNET_WEBHOOK_PORT=8082
#SKYNET_WEBHOOK_BIND=127.0.0.1
