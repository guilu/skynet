# Configuración del runner como servicio. Cópialo a ~/.config/skynet-runner/runner.env
# (chmod 600: lleva el secreto de registro). Lo lee skynet-runner.sh con systemd o launchd.

# URL del control plane: la API (puerto 8080) o la web (8081), que redirige /api.
SKYNET_URL=http://localhost:8080
# Secreto de registro: el mismo SKYNET_RUNNER_REGISTRATION_TOKEN del control plane. Solo hace falta
# la primera vez; después el runner usa el token que guardó en SKYNET_RUNNER_HOME.
SKYNET_RUNNER_REGISTRATION_TOKEN=

# Un servicio no hereda el PATH de tu shell: incluye donde estén `claude`, `git` y `java`.
# Linux, con claude instalado por npm o por el instalador nativo:
PATH=$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin
# macOS con Homebrew:
#PATH=$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
# Java 21 si no es el `java` del PATH:
#JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64

#SKYNET_RUNNER_NAME=mi-portatil
#SKYNET_RUNNER_CAPACITY=2
#SKYNET_RUNNER_HOME=$HOME/.skynet-runner
#SKYNET_CLAUDE_BIN=claude
# Variables extra que hereda el agente (y el comando de verificación), separadas por comas.
#SKYNET_AGENT_ENV=JAVA_HOME,GRADLE_USER_HOME
#SKYNET_LOG_RETENTION_DAYS=7
# Con clave de API en vez de la sesión de `claude login`:
#ANTHROPIC_API_KEY=
